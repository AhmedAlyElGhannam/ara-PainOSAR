# --------------------------------------------------------------------------
# Language level
# --------------------------------------------------------------------------
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# --------------------------------------------------------------------------
# The mandated flag set, mirrored from CMakeLists.txt.
#
# Keep these two lists in step. Divergence means the two build systems produce
# different binaries and one of them is testing something you never ship.
#
# -fsanitize=address must be passed at link time as well as compile time.
# --------------------------------------------------------------------------
build --copt=-g
build --copt=-O0
build --copt=-fsanitize=address
build --copt=-fno-omit-frame-pointer
build --linkopt=-fsanitize=address
build --linkopt=-fno-omit-frame-pointer

# Sanitizer builds must not be stripped, or the stack traces are useless.
build --strip=never

# --------------------------------------------------------------------------
# Warnings
# --------------------------------------------------------------------------
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wpedantic
build --copt=-Wshadow
build --copt=-Wconversion
build --copt=-Werror

# --------------------------------------------------------------------------
# Toolchain
#
# Pin the compiler explicitly so a Bazel build and a CMake build in the same
# container use the same one.
# --------------------------------------------------------------------------
build --repo_env=CC=gcc
build --repo_env=CXX=g++
build --incompatible_strict_action_env

# --------------------------------------------------------------------------
# Tests
#
# Bazel writes JUnit XML to bazel-testlogs/**/test.xml with no extra flags,
# which is what Jenkins ingests.
# --------------------------------------------------------------------------
test --test_output=errors
test --test_summary=detailed
test --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=0
test --test_verbose_timeout_warnings

# --------------------------------------------------------------------------
# CI-specific behaviour, enabled with --config=ci
# --------------------------------------------------------------------------
build:ci --announce_rc
build:ci --show_timestamps
build:ci --verbose_failures
build:ci --keep_going
build:ci --color=no
build:ci --curses=no
test:ci --test_output=errors
test:ci --flaky_test_attempts=1
test:ci --nocache_test_results

# Keep the Bazel cache outside the workspace so Jenkins workspace cleanup does
# not throw it away between builds.
build:ci --disk_cache=/var/cache/bazel/disk
build:ci --repository_cache=/var/cache/bazel/repo

# --------------------------------------------------------------------------
# Resource budget
#
# Bazel sizes its own parallelism from what the *host* reports, and Docker's
# --cpus / --memory are cgroup quotas that do not change those numbers. Left
# alone on a 12-core / 64 GB machine, Bazel launches 12 actions and reserves
# ~42 GB inside a container allowed 4 CPUs and 16 GB -- it thrashes, then the
# kernel OOM-kills it.
#
# Keep these in step with the --cpus and --memory values in the Jenkinsfile.
# 12288 MB of the container's 16 GB leaves headroom for the linker, which is
# the memory spike in a sanitizer build.
# --------------------------------------------------------------------------
build:ci --jobs=4
build:ci --local_ram_resources=12288
build:ci --local_cpu_resources=4

# Interactive local runs: leave the machine usable while a build is going.
build:dev --jobs=6
build:dev --disk_cache=~/.cache/bazel-disk
build:dev --repository_cache=~/.cache/bazel-repo
