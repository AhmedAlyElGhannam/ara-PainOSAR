"""Bazel module definition.

Two version strings below track the Bazel Central Registry rather than this
repository. Check the current values with:

    bazel mod graph
    # or browse https://registry.bazel.build/modules/<name>

Bazel 9 removed the native cc_* rules, so rules_cc is not optional: every
BUILD file must load cc_library / cc_binary / cc_test from it explicitly.
"""

module(
    name = "telemetry",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "googletest", version = "1.18.0", dev_dependency = True)
